<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- app theme, Material 3 with my own colours and the Inter font -->
    <style name="Theme.Assignment2" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_tint</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/grey</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/accent</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <!-- text styles -->

    <!-- base text style -->
    <style name="App.Text" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- app name text at the top of the login screen -->
    <style name="App.Text.Logo">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">30sp</item>
    </style>

    <!-- big screen titles -->
    <style name="App.Text.Headline">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <!-- small red uppercase text above titles -->
    <style name="App.Text.Kicker">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- card titles -->
    <style name="App.Text.Title">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- grey text under titles -->
    <style name="App.Text.Body">
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- form labels -->
    <style name="App.Text.Label">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- red error text under the login button -->
    <style name="App.Text.Error">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- buttons and text fields -->

    <!-- red log in button -->
    <style name="App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/corner</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- outlined button used for "Try again" -->
    <style name="App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/corner</item>
    </style>

    <!-- white text field with a border that goes red when selected -->
    <style name="App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/grey</item>
        <item name="startIconTint">@color/grey</item>
    </style>

    <!-- white rounded card for the list items and the details screen -->
    <style name="App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/line</item>
        <item name="cardCornerRadius">16dp</item>
    </style>
</resources>
