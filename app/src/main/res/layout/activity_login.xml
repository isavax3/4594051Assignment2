<?xml version="1.0" encoding="utf-8"?>
<!-- Login screen (screen 1)
    Cream background, white fields and a red button.
    It's in a ScrollView so the form still fits when the keyboard is open.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.login.LoginActivity">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="20dp">

        <!-- app name with a small red dot after it -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/App.Text.Logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logo" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/dot_accent" />
        </LinearLayout>

        <TextView
            style="@style/App.Text.Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="@string/login_kicker" />

        <TextView
            style="@style/App.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/login_title" />

        <TextView
            style="@style/App.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/login_subtitle" />

        <!-- student id field (this is the username for the api) -->
        <TextView
            style="@style/App.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:labelFor="@id/input_student_id"
            android:text="@string/label_student_id" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_student_id"
            style="@style/App.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:startIconContentDescription="@null"
            app:startIconDrawable="@drawable/ic_user">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_student_id"
                style="@style/App.Text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:autofillHints="username"
                android:hint="@string/hint_student_id"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="12"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColorHint="@color/grey" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- first name field (this is the password, so it's hidden with a show/hide eye) -->
        <TextView
            style="@style/App.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/input_first_name"
            android:text="@string/label_first_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_first_name"
            style="@style/App.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:endIconDrawable="@drawable/ic_password_toggle"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_first_name"
                style="@style/App.Text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:autofillHints="password"
                android:hint="@string/hint_first_name"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColorHint="@color/grey" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- shows why the login didn't work -->
        <TextView
            android:id="@+id/text_error"
            style="@style/App.Text.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <!-- log in button with a spinner on top of it while it's loading -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_login"
                style="@style/App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/log_in"
                app:icon="@drawable/ic_arrow_right"
                app:iconSize="20dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="20dp"
                android:indeterminate="true"
                android:translationZ="4dp"
                android:visibility="gone"
                app:indicatorColor="@color/white"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_slow_note"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/login_slow_note"
            android:visibility="gone" />

        <!-- pushes the class location note to the bottom of the screen -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <TextView
            android:id="@+id/text_location"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="Class location: Footscray" />
    </LinearLayout>
</ScrollView>
