<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard screen (screen 2)
    Header with the topic name, then the RecyclerView with one card per entity.
    The loading, error and empty views sit in the same spot and only one shows at a time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".ui.dashboard.DashboardActivity">

    <!-- header: topic name and item count on the left, log out button on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/App.Text.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_kicker" />

            <TextView
                android:id="@+id/text_topic"
                style="@style/App.Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Mythology" />

            <TextView
                android:id="@+id/text_count"
                style="@style/App.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_count_chip"
                android:fontFamily="@font/inter_semibold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="7 items"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_log_out"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/log_out"
            android:src="@drawable/ic_log_out"
            app:tint="@color/ink" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- the list. clipToPadding=false lets the cards scroll under the bottom padding -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_entities"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_entity"
            tools:visibility="visible" />

        <!-- loading spinner -->
        <LinearLayout
            android:id="@+id/group_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin"
            tools:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/accent" />

            <TextView
                style="@style/App.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/loading_items" />
        </LinearLayout>

        <!-- error message and a button to try again -->
        <LinearLayout
            android:id="@+id/group_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_error"
                style="@style/App.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                tools:text="@string/error_no_connection" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry"
                style="@style/App.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="16dp"
                android:text="@string/try_again" />
        </LinearLayout>

        <!-- shows if the topic has no entities -->
        <TextView
            android:id="@+id/text_empty"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_margin"
            android:text="@string/empty_items"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
